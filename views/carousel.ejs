<div class="movie-carousel">
  <button
    class="movie-carousel-button previous-movies-button"
    type="button"
    aria-label="Show previous movies"
    hidden
  >
    &lt;
  </button>

  <div class="movie-carousel-viewport">
    <div class="movie-carousel-track">
      <% for (let index = 0; index < movies.length; index++) { %>
      <div class="movie-carousel-card">
        <%- include("card.ejs", { movie: movies[index],isMovie:isMovie }) %>
      </div>
      <% } %>
    </div>
  </div>

  <button
    class="movie-carousel-button next-movies-button"
    type="button"
    aria-label="Show next movies"
  >
    &gt;
  </button>
</div>
