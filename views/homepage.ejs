<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Video Club</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/homepage.css" />
    <link rel="stylesheet" href="/css/card.css" />
    <link rel="stylesheet" href="/css/carousel.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include("header.ejs", { username }) %>
    <div class="homepage_container">
      <div class="left_column"></div>
      <div class="main_content">
        <div class="moviesContainer">
          <h2>Upcoming Movies</h2>
          <%- include("carousel.ejs", {movies:movies[0], isMovie:"movie"}) %>
        </div>
        <div class="moviesContainer">
          <h2>Now Playing Movies</h2>
          <%- include("carousel.ejs", {movies:movies[1],isMovie:"movie"}) %>
        </div>
        <div class="moviesContainer">
          <h2>Top Rated Movies</h2>
          <%- include("carousel.ejs", {movies:movies[2],isMovie:"movie"}) %>
        </div>
        <div class="moviesContainer">
          <h2>Top Rated TV Shows</h2>
          <%- include("carousel.ejs", {movies:tvShows[0],isMovie:"tvShow"}) %>
        </div>
        <div class="moviesContainer">
          <h2>On The Air TV Shows</h2>
          <%- include("carousel.ejs", {movies:tvShows[1],isMovie:"tvShow"}) %>
        </div>
        <div class="moviesContainer">
          <h2>Popular TV Shows</h2>
          <%- include("carousel.ejs", {movies:tvShows[2],isMovie:"tvShow"}) %>
        </div>
      </div>
      <div class="right_column"></div>
    </div>
    <script src="/js/carousel.js"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
