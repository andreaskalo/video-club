<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/cardDetails.css" />
    <link rel="stylesheet" href="/css/actorCard.css" />
    <link rel="stylesheet" href="/css/actorCarousel.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include("header.ejs", { username }) %>
    <div class="main_container">
      <div class="left_column"></div>
      <div class="main_content">
        <div class="header_container">
          <div class="title_container">
            <div class="title_star_container">
              <h2 style="padding-right: 5px">
                <%= details.title || details.name %> |
              </h2>
              <div class="star_container">
                <img
                  src="/images/star.png"
                  height="30px"
                  width="30px"
                /><%= parseFloat(details.vote_average).toFixed(1) %>
              </div>
            </div>

            <ul class="below_header_details">
              <li>
                <%= isMovie === "movie" ? "Movie" : "TV Show" %>
              </li>
              <li>
                <% if (isMovie === "movie") { %>
                <%= details.release_date
                ? convertDate(details.release_date,isMovie)
                : "Release date unavailable"
                %>
                <% } else { %>
                <%= details.first_air_date
                ? convertDate(details.first_air_date,isMovie)
                : "Unknown"
                %>
                -

                <%= details.last_air_date
                ? convertDate(details.last_air_date)
                : "Present"
                %>
                <% } %>
              </li>
              <% if (details.runtime) { %>
              <li><%= details.runtime %>m</li>
              <% } %>
            </ul>
            <div><i><%= details.tagline %></i></div>
          </div>
        </div>
        <div class="top_container">
          <div class="image_container">
            <img
              src="https://image.tmdb.org/t/p/w500<%= details.poster_path %>"
              alt="<%= details.title || details.name || 'Poster' %>"
              class="poster_size_card_details"
            />
          </div>
          <% if (trailer) { %>
          <div class="trailer_section">
            <div class="trailer_container">
              <iframe
                src="https://www.youtube.com/embed/<%= trailer.key %>"
                title="<%= details.title || details.name || 'Trailer' %>"
                allow="
                  accelerometer;
                  autoplay;
                  clipboard-write;
                  encrypted-media;
                  gyroscope;
                  picture-in-picture;
                  web-share;
                "
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
          <% } else { %>
          <div class="trailer_section">
            <p>No trailer is available for this title.</p>
          </div>
          <% } %>
        </div>
        <div class="middle_container">
          <h2>Overview</h2>
          <div>
            <%= details.overview %>
          </div>
          <h2>Featured Actors</h2>
          <div class="actors">
            <%- include("actorCarousel.ejs", {actors:actors}) %>
          </div>
        </div>
        <div class="bottom_container">
          <div class="header_container">
            <div class="title_container">
              <div>
                <h2>Genres</h2>
                <ul class="bottom_information">
                  <% details.genres.forEach(genre => { %>
                  <li>
                    <%= genre.name %>
                  </li>
                  <% }) %>
                </ul>
              </div>

              <div>
                <h2>Production Countries</h2>

                <%= details.production_countries.map(country => country.name)
                .join(", ") %>
              </div>
              <div>
                <h2>Production Companies</h2>
                <%= details.production_companies.map(company => company.name)
                .join(", ") %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="right_column"></div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script src="/js/actorCarousel.js"></script>
  </body>
</html>
