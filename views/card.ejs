<div class="card shadow-sm movie-card">
  <img
    src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
    alt="<%= movie.title %> poster"
    class="card-img-top"
  />

  <div class="card-body">
    <h5 class="card-title"><%= movie.title %></h5>

    <p class="card-text"><%= movie.overview %></p>

  </div>
</div>
